{
  "name": "humpyard-admin-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The humpyard admin GUI (ADR 0032): a client of /admin/v1, built to static files that `humpyard ui` embeds.",
  "scripts": {
    "generate": "openapi-typescript ../docs/openapi/admin-v1.json -o src/api/schema.d.ts",
    "check:generated": "npm run generate && git diff --exit-code -- src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && node scripts/check-dist.mjs",
    "audit": "npm audit --omit=dev && npm audit --audit-level=high"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
