        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverride"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The override, recorded as created by `admin:<id>`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Override"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "An unknown kind, a subject the configuration lacks, or an expiry beyond the maximum.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "No ledger is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The override could not be stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/overrides/{id}": {
      "delete": {
        "operationId": "removeOverride",
        "summary": "Remove an override in force",
        "security": [
          {
            "adminBearer": [
              "overrides"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required",
          "override_not_found",
          "ledger_error"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The override's id.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The override was removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "removed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No override with that id is in force.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An admin credential's secret. The scope named in an operation's `security` is one of `read`, `overrides` or `credentials`."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "description": "With `admin_scope_required`: the scope the credential lacks."
              }
            }
          }
        }
      },
      "Principal": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scopes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "credential"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "overrides",
                "credentials"
              ]
            }
          },
          "expires": {
            "type": "string",
            "nullable": true,
            "description": "A UTC time, or null when it does not expire."
          }
        }
      },
      "Credential": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Principal"
          },
          {
            "type": "object",
            "properties": {
              "revoked": {
                "type": "boolean",
                "description": "True while a revocation is in force."
              }
            }
          }
        ]
      },
      "Override": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "disable_target",
              "drain_provider",
              "pin_route"
            ]
          },
          "subject": {
            "type": "string"
          },
          "route": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string"
          },
          "created_ms": {
            "type": "integer"
          },
          "expires_ms": {
            "type": "integer"
          },
          "expires_in_secs": {
            "type": "integer"
          },
          "created_by": {
            "type": "string",
            "description": "`admin:<id>` for an admin credential, otherwise a client key id."
          },
          "stale": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "description": "With `history=true` only."
          },
          "ended_ms": {
            "type": "integer",
            "nullable": true,
            "description": "With `history=true` only."
          }
        }
      },
      "CreateOverride": {
        "type": "object",
        "required": [
          "kind",
          "subject",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "disable_target",
              "drain_provider",
              "pin_route"
            ]
          },
          "subject": {
            "type": "string"
          },
          "route": {
            "type": "string",
            "description": "Required for `pin_route`."
          },
          "reason": {
            "type": "string"
          },
          "expires_in_secs": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "RevokeRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "expires_in_secs": {
            "type": "integer",
            "minimum": 1,
            "description": "Default four hours, at most the `[overrides]` maximum."
          }
        }
      },
      "Revocation": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "created_by": {
            "type": "string"
          },
          "expires_ms": {
            "type": "integer"
          },
          "expires_in_secs": {
            "type": "integer"
          }
        }
      },
      "ResponseSignal": {
        "type": "string",
        "enum": [
          "empty_output",
          "truncated_output",
          "bad_tool_call",
          "cut_stream"
        ],
        "description": "One fact about an answer (ADR 0030): `empty_output` (finished with no text and no tool call; reasoning alone does not count), `truncated_output` (the provider stopped it at its output limit), `bad_tool_call` (a tool call with no name, or with arguments that are neither blank nor a JSON object) or `cut_stream` (the provider's stream ended or failed before its final chunk). Only that a fact is set is kept, never any text."
      },
      "ResponseSignalCounts": {
        "type": "object",
        "description": "How the group's answer calls fared on the response signals: `observed` is the number of answer calls whose signals are known, and each other field counts those that carried that signal, so a rate is a count over `observed`. Calls with unknown signals (written before ledger schema v13, routing-time judge calls) are in neither figure.",
        "required": [
          "observed",
          "empty_output",
          "truncated_output",
          "bad_tool_call",
          "cut_stream"
        ],
        "properties": {
          "observed": {
            "type": "integer",
            "minimum": 0
          },
          "empty_output": {
            "type": "integer",
            "minimum": 0
          },
          "truncated_output": {
            "type": "integer",
            "minimum": 0
          },
          "bad_tool_call": {
            "type": "integer",
            "minimum": 0
          },
          "cut_stream": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Decision": {
        "type": "object",
        "description": "A routing decision, as `GET /v1/decisions` returns it. Only the fields listed here are part of the contract; others may be present.",
        "required": [
          "request_id",
          "ts_ms",
          "route",
          "outcome",
          "status",
          "request",
          "attempts",
          "served"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "ts_ms": {
            "type": "integer",
            "description": "When the decision was made, in epoch milliseconds."
          },
          "key": {
            "type": "string",
            "nullable": true,
            "description": "The client key the request came in with."
          },
          "route": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "request": {
            "type": "object",
            "description": "Facts about the request: `stream`, `prompt_tokens_estimate`, `tools`, `images`, and `repaired_tool_arguments` when some were."
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "served": {
            "type": "object",
            "description": "The `target` and `provider` that served it."
          },
          "response_signals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponseSignal"
            },
            "description": "The signals set on the call that served the request, read from the usage ledger. Absent when none is set, when they are unknown (a decision from before schema v13) and while the answer is still streaming."
          }
        }
      },
      "StatsGroup": {
        "type": "object",
        "description": "Performance of one group over the window, as `GET /v1/stats` returns it. Only the fields listed here are part of the contract; others may be present.",
        "required": [
          "group",
          "requests",
          "attempts",
          "failures",
          "fallbacks",
          "answered",
          "outcomes",
          "tokens",
          "response_signals"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "requests": {
            "type": "integer"
          },
          "attempts": {
            "type": "integer"
          },
          "failures": {
            "type": "integer"
          },
          "fallbacks": {
            "type": "integer"
          },
          "answered": {
            "type": "integer"
          },
          "outcomes": {
            "type": "object"
          },
          "tokens": {
            "type": "object",
            "required": [
              "input",
              "cached_input",
              "cache_creation",
              "output"
            ],
            "properties": {
              "input": {
                "type": "integer"
              },
              "cached_input": {
                "type": "integer"
              },
              "cache_creation": {
                "type": "integer"
              },
              "output": {
                "type": "integer"
              }
            }
          },
          "response_signals": {
            "$ref": "#/components/schemas/ResponseSignalCounts"
          }
        }
      }
    }
  }
}
