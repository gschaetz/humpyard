{
  "openapi": "3.0.3",
  "info": {
    "title": "humpyard admin API",
    "version": "1",
    "description": "The operator surface of a humpyard gateway (ADR 0027). Opened only by an admin credential defined in the configuration's `[admin]` section; a client key never opens it. Without a configured credential the whole namespace answers 404. Every operation lists the scope it needs under `security`, and the error codes it can answer with under `x-error-codes`; a test fails when this document and the served routes differ."
  },
  "servers": [
    {
      "url": "/",
      "description": "The gateway, or its `[admin] listen` address."
    }
  ],
  "security": [
    {
      "adminBearer": []
    }
  ],
  "paths": {
    "/admin/v1/whoami": {
      "get": {
        "operationId": "whoami",
        "summary": "Who the caller is",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid"
        ],
        "responses": {
          "200": {
            "description": "The caller's id, scopes and expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Principal"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This document",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid"
        ],
        "responses": {
          "200": {
            "description": "The OpenAPI document of the admin API.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/config": {
      "get": {
        "operationId": "config",
        "summary": "The effective configuration, with the admin section in full",
        "security": [
          {
            "adminBearer": [
              "read"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required"
        ],
        "responses": {
          "200": {
            "description": "The configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "As `GET /v1/config`, plus an `admin` object listing each credential's id, scopes and expiry."
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Gateway health",
        "security": [
          {
            "adminBearer": [
              "read"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required"
        ],
        "responses": {
          "200": {
            "description": "Skipped endpoints, latency, the loaded configuration and the last reload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "As `GET /v1/health`."
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/quota": {
      "get": {
        "operationId": "quota",
        "summary": "Provider quota",
        "security": [
          {
            "adminBearer": [
              "read"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required"
        ],
        "responses": {
          "200": {
            "description": "Quota windows and their state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "As `GET /v1/quota`."
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/decisions": {
      "get": {
        "operationId": "decisions",
        "summary": "The routing decision log of every key",
        "security": [
          {
            "adminBearer": [
              "read"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only the decisions of this client key; omit for every key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows to return (default 50, at most 500).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "since_ms",
            "in": "query",
            "required": false,
            "description": "Only decisions at or after this time, in epoch milliseconds.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Only this route.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rule",
            "in": "query",
            "required": false,
            "description": "Only this rule.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "required": false,
            "description": "Only this outcome.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "request_id",
            "in": "query",
            "required": false,
            "description": "Only this request.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decisions, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Decision"
                      }
                    }
                  },
                  "required": [
                    "object",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "An unknown filter or a malformed number.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No ledger is configured, so decisions are not recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/stats": {
      "get": {
        "operationId": "stats",
        "summary": "Statistics of every key",
        "security": [
          {
            "adminBearer": [
              "read"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only the statistics of this client key; omit for every key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "How far back, for example `1h` or `7d`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "description": "`route` (default), `target` or `endpoint`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Only this route.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target",
            "in": "query",
            "required": false,
            "description": "Only this target.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistics over the window.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Statistics over the window, as `GET /v1/stats`.",
                  "required": [
                    "object",
                    "group_by",
                    "window",
                    "truncated",
                    "data"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "stats"
                      ]
                    },
                    "group_by": {
                      "type": "string"
                    },
                    "window": {
                      "type": "object"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StatsGroup"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "An unknown parameter or a malformed window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/credentials": {
      "get": {
        "operationId": "listCredentials",
        "summary": "Every admin credential",
        "security": [
          {
            "adminBearer": [
              "read"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required"
        ],
        "responses": {
          "200": {
            "description": "Credentials: id, scopes, expiry and whether a revocation is in force. Never a hash.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Credential"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/credentials/{id}/revoke": {
      "post": {
        "operationId": "revokeCredential",
        "summary": "Revoke an admin credential for a bounded time",
        "security": [
          {
            "adminBearer": [
              "credentials"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required",
          "invalid_revocation",
          "overrides_need_ledger",
          "already_revoked",
          "ledger_error"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The credential to revoke.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The revocation now in force.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revocation"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Not a configured admin credential, a missing reason, or an expiry beyond the maximum.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Already revoked, or no ledger is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The revocation could not be stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "endRevocation",
        "summary": "End a revocation before it expires",
        "security": [
          {
            "adminBearer": [
              "credentials"
            ]
          }
        ],
        "x-error-codes": [
          "admin_credential_invalid",
          "admin_scope_required",
          "revocation_not_found"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The credential whose revocation to end.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The revocation has ended.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "string"
                    },
                    "revoked": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked credential. One shape for every reason.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A valid credential without the scope the operation needs; `error.scope` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No revocation is in force for that credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/overrides": {
      "get": {
        "operationId": "listOverrides",
        "summary": "Runtime overrides",
        "security": [
          {
            "adminBearer": [
              "read"
